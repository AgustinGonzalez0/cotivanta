{
  "name": "cotivanta",
  "private": true,
  "version": "0.1.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node scripts/serve.cjs",
    "build": "node scripts/build.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:db": "node --test tests/database.e2e.cjs",
    "test:browser": "node --test tests/browser.e2e.cjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run test:db && npm run test:browser && npm run build"
  },
  "devDependencies": { "@electric-sql/pglite": "0.5.15", "typescript": "7.0.2" }
}
